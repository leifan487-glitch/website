# Public build variables. These values are embedded in the Vite client bundle.
VITE_SITE_URL=
VITE_INQUIRY_ENABLED=false

# Cloudflare Pages Function / Worker runtime variables.
MAIL_PROVIDER=resend
INQUIRY_TO_EMAIL=business@bluewormrobotics.com
INQUIRY_FROM_EMAIL=

# Runtime secrets. Configure as encrypted Cloudflare secrets; never commit values.
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=

# Future public Turnstile widget key. Leave empty until the client widget is implemented.
VITE_TURNSTILE_SITE_KEY=
